# OpenAI-protocol upstream (DeepSeek by default). Swap base_url/model to use
# GPT / Claude (via proxy) / Ollama without code changes.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
MODEL_NAME=deepseek-chat
HOST=0.0.0.0
PORT=8000
MAX_CONTEXT_TOKENS=4096
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/cs_customer?charset=utf8mb4

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowledge
MILVUS_HYBRID_COLLECTION=knowledge_hybrid
HYBRID_RECALL_TOP_K=50
HYBRID_RRF_K=60
RERANK_TOP_N=10
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Empty values fall back to EMBEDDING_BASE_URL / EMBEDDING_API_KEY.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_TIMEOUT_S=10.0
QUERY_REWRITE_ENABLED=true
FAQ_TOP_K=3
FAQ_SCORE_THRESHOLD=0.5
KNOWLEDGE_DOCS_DIR=knowledge
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=80
QA_MINING_BATCH_SIZE=10
QA_DEDUP_THRESHOLD=0.92

AGENT_MAX_STEPS=6
AGENT_TOKEN_BUDGET=12000
AGENT_TOOL_RESULT_MAX_CHARS=2000
# DEPRECATED (ch09): legacy ch05 path only; the ch09 evidence gate ignores it.
CONFIDENCE_MIN_SCORE=0.1
LANGGRAPH_CHECKPOINT_DB=.data/ch05-checkpoints.sqlite

# --- ch07 conversation context ---
# Budget is derived from the model window. Leave MAX_AGENT_STEPS /
# TOOL_RESULT_MAX_TOKENS / RERANK_TOP_K commented out or blank to fall back to
# the ch05/ch04 values above (AGENT_MAX_STEPS, AGENT_TOOL_RESULT_MAX_CHARS,
# RERANK_TOP_N).
MODEL_CONTEXT_WINDOW=65536
MAX_OUTPUT_TOKENS=2000
MAX_USER_INPUT_TOKENS=2000
# MAX_AGENT_STEPS=3
# TOOL_RESULT_MAX_TOKENS=1200
# RERANK_TOP_K=5
SAFETY_MARGIN_RATIO=0.10
SYSTEM_PROMPT_RESERVE_TOKENS=1200
EVIDENCE_TOKENS_PER_CHUNK=250
SUMMARY_RESERVE_TOKENS=500
HISTORY_TARGET_TURNS=30
HISTORY_TOKENS_PER_TURN=300
LAYER1_RATIO=0.7
LAYER1_DEGRADE_LOW_WATER_RATIO=0.8
ASSISTANT_L2_CHARS=40
TOOL_RESULT_MARKER_CHARS=200
SUMMARY_MODEL=
SUMMARY_MAX_CHARS=200
CH07_CHECKPOINT_DB=.data/ch07-checkpoints.sqlite
CONTEXT_LOG_PREVIEW_CHARS=40
LOG_TO_FILE=true

# --- ch08 tool system ---
MCP_ENABLED=false
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
MCP_DISCOVERY_TIMEOUT_S=2
MCP_TOOL_TIMEOUT_S=10
TOOL_DEFAULT_TIMEOUT_S=5
TOOL_MAX_RETRIES=2
TOOL_AUDIT_RESULT_MAX_CHARS=500
# Read by the logistics MCP server process, not by the main service.
MOCK_DELAY_SECONDS=0
# Read by the main service; create_ticket sleeps after the DB commit.
DEMO_TICKET_DELAY_SECONDS=0

# --- ch09 observability & data flywheel ---
# Langfuse v3: tracing is enabled only when public key, secret key, and base
# URL are all set; otherwise the callback handler is not attached.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_ENVIRONMENT=development
LANGFUSE_TRACE_NAME=cs-chat
STREAM_USAGE=true

# Evidence confidence gate (threshold calibrated against the ch04 eval set).
EVIDENCE_CONFIDENCE_THRESHOLD=0.0
EVIDENCE_VALID_FLOOR=0.1
EVIDENCE_VALID_CAP=3
EVIDENCE_MARGIN_SCALE=0.2
LOW_CONFIDENCE_SNAPSHOT_TOP_K=3

# Flywheel batch job.
FLYWHEEL_CANDIDATE_LIMIT=200
FLYWHEEL_LLM_MAX_TOKENS=800
FLYWHEEL_TIMEOUT_S=20

# Reports written by cost/eval jobs.
CH09_REPORT_DIR=data/ch09/reports
